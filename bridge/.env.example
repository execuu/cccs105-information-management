# Copy to .env

# Reader mode:
#   serial   = Arduino Uno + RC522 over USB serial
READER_MODE=serial

# Serial mode: port Arduino is connected to.
#   Linux:   /dev/ttyACM0  (or /dev/ttyUSB0)
#   macOS:   /dev/cu.usbmodem14201 (check Arduino IDE Tools > Port)
#   Windows: COM3  (or COM4, check Device Manager / Arduino IDE)
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=9600

# Backend scan endpoint
DJANGO_URL=http://localhost:8000

# Must match BRIDGE_KEY in backend/.env
BRIDGE_KEY=change-me-bridge-key

# Timeouts / retries
REQUEST_TIMEOUT_SECONDS=5
MAX_RETRIES=3
INITIAL_BACKOFF_SECONDS=0.5
RECONNECT_DELAY_SECONDS=2
